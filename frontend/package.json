{
  "name": "@dataset-studio/frontend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xuness/dataset-annotation-studio.git",
    "directory": "frontend"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "pnpm test:state && pnpm test:ui",
    "test:state": "node --test tests/state-regressions.test.ts",
    "test:ui": "vitest run",
    "api:generate": "uv run --project ../backend --no-sync python ../scripts/export-openapi.py openapi/openapi.json && openapi-typescript openapi/openapi.json -o src/shared/api/generated/schema.ts --export-type",
    "api:check": "uv run --project ../backend --no-sync python ../scripts/export-openapi.py --check openapi/openapi.json && openapi-typescript openapi/openapi.json -o src/shared/api/generated/schema.ts --export-type --check",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "pnpm format:check && pnpm api:check && pnpm check:architecture && pnpm test && tsc -b --pretty false && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/view": "^6.38.6",
    "@tanstack/react-query": "^5.85.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.4.0",
    "@uiw/react-codemirror": "^4.25.2",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "three": "^0.185.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.4",
    "vitest": "^4.1.10"
  }
}
